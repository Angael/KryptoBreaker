{
	"name": "kryptobreaker",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.json && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"lint": "oxlint",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"firebase": "^13.1.0",
		"lucide-react": "^1.66.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"fast-check": "^4.10.2",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5"
	}
}
